# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# These become relevant in ROADMAP Phase 2 (accounts + sync). Not needed for the MVP.

# Supabase (public/anon — safe for the browser; protection comes from Row-Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — NEVER prefix these with VITE_ and never expose to the client
# RESEND_API_KEY=
